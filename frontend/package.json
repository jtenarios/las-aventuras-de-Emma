{
  "name": "las-aventuras-de-emma",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run prepare:stories && ng serve",
    "build": "npm run prepare:stories && ng build --base-href /cuentos/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare:stories": "node ../scripts/prepare-story-catalog.mjs",
    "build:worker": "npm run build && node ../scripts/prepare-worker-assets.mjs",
    "deploy": "npm run build:worker && wrangler deploy --config ../wrangler.jsonc"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "wrangler": "^4.152.0"
  }
}
